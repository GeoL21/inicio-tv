<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="232dp"
    android:layout_height="139dp"
    android:background="@drawable/marco_fondo"
    android:padding="5dp">

    <ImageView
        android:id="@+id/imagen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF262626"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="10dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="@color/texto"
        android:textFontWeight="500"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/marca"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/marca_actual"
        android:visibility="gone" />
    <!-- Descarga en curso (solo en línea) -->
    <FrameLayout
        android:id="@+id/descarga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/descargando"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <View
            android:id="@+id/progreso_descarga"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|start"
            android:background="#FFFFFFFF" />
    </FrameLayout>
</FrameLayout>
