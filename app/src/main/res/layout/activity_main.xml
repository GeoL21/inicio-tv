<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/velo_arriba" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/velo_abajo" />

    <!-- Hora (12 horas), fecha y saludo -->
    <LinearLayout
        android:id="@+id/bloque_reloj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/reloj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_reloj"
                android:format12Hour="h:mm"
                android:format24Hour="h:mm"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/texto"
                android:textFontWeight="500"
                android:textSize="84sp" />

            <TextClock
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour="a"
                android:textColor="@color/texto_suave"
                android:textFontWeight="500"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_suave"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/saludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto"
            android:textFontWeight="500"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Clima y accesos rápidos -->
    <LinearLayout
        android:id="@+id/barra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/clima_icono"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/clima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/texto"
            android:textSize="20sp" />

        <ImageButton android:id="@+id/btn_fondos" style="@style/BotonRapido"
            android:contentDescription="@string/fondos" android:src="@drawable/ic_fondo" />

        <ImageButton android:id="@+id/btn_red" style="@style/BotonRapido"
            android:contentDescription="@string/red" android:src="@drawable/ic_red" />

        <ImageButton android:id="@+id/btn_entradas" style="@style/BotonRapido"
            android:contentDescription="@string/entradas" android:src="@drawable/ic_tv" />

        <ImageButton android:id="@+id/btn_hdmi" style="@style/BotonRapido"
            android:contentDescription="@string/hdmi" android:src="@drawable/ic_hdmi" />

        <ImageButton android:id="@+id/btn_ajustes" style="@style/BotonRapido"
            android:contentDescription="@string/ajustes" android:src="@drawable/ic_ajustes" />
    </LinearLayout>

    <!-- Dock: centrado, se ajusta al número de apps (máximo 8) -->
    <FrameLayout
        android:id="@+id/dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="46dp"
        android:background="@drawable/fondo_dock"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/fila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </FrameLayout>

    <!-- Pista: flecha abajo abre todas las apps (o cómo mover) -->
    <TextView
        android:id="@+id/pista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:drawableStart="@drawable/ic_flecha_abajo"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/todas_las_apps"
        android:textColor="@color/texto_suave"
        android:textSize="14sp" />

    <!-- Cajón con todas las apps: sube sobre el fondo -->
    <FrameLayout
        android:id="@+id/cajon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="18dp"
            android:drawableStart="@drawable/ic_flecha_arriba"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/inicio"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <GridView
            android:id="@+id/cuadricula"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="52dp"
            android:clipToPadding="false"
            android:columnWidth="104dp"
            android:gravity="center"
            android:horizontalSpacing="8dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="auto_fit"
            android:paddingStart="56dp"
            android:paddingTop="8dp"
            android:paddingEnd="56dp"
            android:paddingBottom="48dp"
            android:scrollbars="none"
            android:stretchMode="spacingWidthUniform"
            android:verticalSpacing="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:text="@string/ayuda_apps"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- Panel de entradas: cable y HDMI, con cuáles tienen un equipo conectado -->
    <FrameLayout
        android:id="@+id/panel_entradas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hoja_entradas"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#EB141414"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/entradas_titulo"
                android:textColor="@color/texto"
                android:textFontWeight="500"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/lista_entradas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ayuda_entradas"
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
