<?xml version="1.0" encoding="utf-8"?>
<!-- Pestañas de Fondos: con foco, píldora blanca; la elegida, subrayada -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="20dp" /><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2dp" android:start="18dp" android:end="18dp">
                <shape><solid android:color="#FFFFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
